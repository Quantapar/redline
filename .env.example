# ---- Core infra (local defaults work out of the box) ----
NODE_ENV=development
DATABASE_URL=postgresql://manu@localhost:5432/redline
REDIS_URL=redis://localhost:6379
# Password for the docker-compose Postgres service (only needed for `docker compose up`;
# the local dev DB above uses your OS user). Choose any value.
POSTGRES_PASSWORD=

# ---- AI model router (0G Compute Router, OpenAI-compatible) ----
# Leave blank to run the model layer on deterministic fixtures (offline mode).
OG_ROUTER_API_KEY=
OG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# Route sensitive attack-writing through the router's private/TEE mode (keeps code secret).
OG_PRIVATE_MODE=false

# ---- Blockchain fork source ----
# Archive RPC (e.g. Alchemy) used to fork a chain at an exact block.
ARCHIVE_RPC_URL=
# For real referee independence, give several INDEPENDENT providers, comma-separated
# (Alchemy, Infura, Ankr, ...). Each referee forks from a different one. Takes
# precedence over ARCHIVE_RPC_URL when set.
ARCHIVE_RPC_URLS=
SEPOLIA_RPC_URL=

# ---- GitHub App (register at github.com/settings/apps) ----
# See docs/GITHUB_APP.md. The App ID is on the app's settings page.
GITHUB_APP_ID=
# Provide the private key inline (full .pem contents) OR as a file path — not both.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# A smee.io channel (https://smee.io/new) for local webhook delivery; the app
# connects to it automatically, so no separate forwarder process is needed.
GITHUB_WEBHOOK_PROXY_URL=
# Only for the OAuth login layer (not needed for the check/scan flow).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Billing (Stripe test mode, optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Security ----
# 32-byte base64 key for encrypting customer artifacts at rest.
ENCRYPTION_KEY=

# ---- Going-live demo (optional) ----
DEMO_WALLET_KEY=

# ---- Web ----
# Admin token for ops endpoints (e.g. /api/watch). Unset in dev leaves them open.
REDLINE_ADMIN_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Tuning (optional; defaults shown) ----
# How many scan jobs the worker processes at once.
SCAN_CONCURRENCY=2
# Port the GitHub App (Probot) listens on.
PORT=3001
# Base URL the CLI's `redline verify-deploy` calls (also settable with --url).
REDLINE_URL=http://localhost:3000
