{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@redline/shared": ["packages/shared/src/index.ts"],
      "@redline/db": ["packages/db/src/index.ts"],
      "@redline/engine": ["packages/engine/src/index.ts"],
      "@redline/hunters": ["packages/hunters/src/index.ts"],
      "@redline/worker": ["packages/worker/src/index.ts"]
    }
  }
}
