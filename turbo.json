{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV", "DATABASE_URL", "REDIS_URL", "OG_ROUTER_API_KEY", "OG_ROUTER_BASE_URL",
    "ARCHIVE_RPC_URL", "GITHUB_APP_ID", "GITHUB_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET",
    "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET",
    "ENCRYPTION_KEY", "NEXT_PUBLIC_APP_URL", "SEPOLIA_RPC_URL", "DEMO_WALLET_KEY"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:e2e": { "dependsOn": ["^build"], "cache": false },
    "clean": { "cache": false }
  }
}
