{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous security testing for smart contracts. Proof, not opinion.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:push": "pnpm --filter @redline/db push",
    "db:migrate": "pnpm --filter @redline/db migrate",
    "db:studio": "pnpm --filter @redline/db studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify": "pnpm -r typecheck && pnpm -r --workspace-concurrency=1 test",
    "start": "pnpm --filter @redline/web dev",
    "worker": "pnpm --filter @redline/worker start"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "prettier": "3.4.2"
  }
}
